@{
    // Layout ko null kar diya taaki Navbar login page par na dikhe
    Layout = null; 
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - SmartOfficeSystem</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <style>
        :root {
            --saas-primary: #4361ee;
            --saas-dark: #1e293b;
        }

        body {
            background-color: #f8fafc;
            background-image: radial-gradient(#e2e8f0 1.5px, transparent 1.5px);
            background-size: 30px 30px;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .login-container {
            width: 100%;
            max-width: 420px;
            padding: 20px;
            z-index: 10;
        }

        .saas-card {
            background: #ffffff;
            border-radius: 24px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.1);
            border: 1px solid #e2e8f0;
            padding: 40px;
        }

        .brand-logo {
            width: 54px;
            height: 54px;
            background: var(--saas-primary);
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 24px;
            color: white;
            font-size: 1.6rem;
            box-shadow: 0 10px 15px -3px rgba(67, 97, 238, 0.3);
        }

        .login-title {
            color: var(--saas-dark);
            font-weight: 800;
            font-size: 1.8rem;
            text-align: center;
            margin-bottom: 8px;
        }

        .login-subtitle {
            color: #64748b;
            text-align: center;
            font-size: 0.95rem;
            margin-bottom: 32px;
        }

        .form-label {
            font-weight: 600;
            font-size: 0.85rem;
            color: #475569;
            margin-bottom: 8px;
        }

        .form-control {
            border-radius: 12px;
            padding: 12px 16px;
            border: 1.5px solid #e2e8f0;
            background-color: #f8fafc;
            transition: all 0.2s;
        }

        .form-control:focus {
            border-color: var(--saas-primary);
            box-shadow: 0 0 0 4px rgba(67, 97, 238, 0.1);
            outline: none;
            background-color: white;
        }

        .btn-saas {
            background-color: var(--saas-primary);
            color: white;
            font-weight: 700;
            padding: 14px;
            border-radius: 12px;
            border: none;
            width: 100%;
            margin-top: 10px;
            transition: all 0.2s;
        }

        .btn-saas:hover {
            background-color: #3730a3;
            transform: translateY(-1px);
        }

        .footer-text {
            position: absolute;
            bottom: 20px;
            color: #94a3b8;
            font-size: 0.85rem;
        }
    </style>
</head>
<body>

    <div class="login-container">
        <div class="saas-card">
            <div class="brand-logo">
                <i class="fas fa-rocket"></i>
            </div>
            <h2 class="login-title">Welcome Back</h2>
            <p class="login-subtitle">Sign in to manage your office tasks</p>

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger d-flex align-items-center" style="border-radius: 12px; font-size: 0.85rem;">
                    <i class="fas fa-exclamation-circle me-2"></i> @TempData["Error"]
                </div>
            }
    
    <div asp-validation-summary="ModelOnly" class="text-danger" style="font-weight:bold;"></div>

            <form asp-action="Login" asp-controller="Account" method="post">
                <div class="mb-4">
                    <label class="form-label">Username</label>
                    <input type="text" name="username" class="form-control" placeholder="Enter username" required />
                </div>
                
                <div class="mb-4">
                    <div class="d-flex justify-content-between">
                        <label class="form-label">Password</label>
                        <a href="#" class="text-primary text-decoration-none small fw-bold">Forgot?</a>
                    </div>
                    <input type="password" name="password" class="form-control" placeholder="••••••••" required />
                </div>

                <button type="submit" class="btn btn-saas shadow-lg">
                    Continue <i class="fas fa-chevron-right ms-2 small"></i>
                </button>
            </form>

            <div class="text-center mt-4">
                <p class="small text-muted">Need help? <a href="#" class="text-primary text-decoration-none fw-bold">Contact Support</a></p>
            </div>
        </div>
    </div>

    <div class="footer-text">
        &copy; 2026 SmartOfficeSystem — Professional Edition
    </div>

</body>
</html>