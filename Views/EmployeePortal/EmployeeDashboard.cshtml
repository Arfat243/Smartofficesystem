@model List<SmartOfficeSystem.Models.TaskModel>
@{
    Layout = "_Layout";
    var attendance = ViewBag.TodayAttendance as SmartOfficeSystem.Models.AttendanceModel;
}

<style>
    body { background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%); min-height: 100vh; }
    .main-card { background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(10px); border-radius: 20px; border: 1px solid rgba(255, 255, 255, 0.3); margin-bottom: 2rem; }
    .stat-card { border: none; border-radius: 15px; color: white; transition: all 0.3s ease; }
    .stat-card:hover { transform: scale(1.03); box-shadow: 0 10px 20px rgba(0,0,0,0.1); }
    .bg-gradient-blue { background: linear-gradient(45deg, #007bff, #00d2ff); }
    .bg-gradient-red { background: linear-gradient(45deg, #ff416c, #ff4b2b); }
    .bg-gradient-green { background: linear-gradient(45deg, #11998e, #38ef7d); }
    .custom-badge { padding: 8px 15px; border-radius: 10px; font-weight: 600; text-transform: uppercase; font-size: 0.7rem; }
</style>

<div class="container py-5">
    @* --- HEADER & PUNCH SECTION --- *@
    <div class="main-card p-4 shadow-sm mb-4">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h4 class="text-muted mb-0">Portal Dashboard</h4>
                <h2 class="fw-bold text-dark">Welcome, @Context.Session.GetString("UserSession")</h2>
            </div>
            
            <div class="d-flex gap-2 align-items-center">
                @if (ViewBag.IsPunchedIn == false)
                {
                    <form asp-controller="EmployeePortal" asp-action="PunchIn" method="post">
                        <button type="submit" class="btn btn-success rounded-pill px-4 fw-bold shadow-sm">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Punch In
                        </button>
                    </form>
                }
                else
                {
                    <form asp-controller="EmployeePortal" asp-action="PunchOut" method="post">
                        <button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold shadow-sm">
                            <i class="bi bi-box-arrow-left me-1"></i> Punch Out
                        </button>
                    </form>
                }

                <a asp-action="ApplyLeave" class="btn btn-warning rounded-pill px-4 fw-bold shadow-sm">
                    <i class="bi bi-calendar-plus me-1"></i> Apply Leave
                </a>
            </div>
        </div>
        @if (ViewBag.IsPunchedIn == true)
        {
            <div class="mt-2 text-success fw-bold italic">
                <i class="bi bi-clock-fill"></i> You are currently active. Punched in at: @ViewBag.PunchInTime
            </div>
        }
    </div>

    @* --- STATS CARDS --- *@
    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <div class="card stat-card bg-gradient-blue p-4 shadow">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-uppercase opacity-75">Total Tasks</h6>
                        <h2 class="display-6 fw-bold">@Model.Count</h2>
                    </div>
                    <i class="bi bi-briefcase display-4 opacity-25"></i>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card stat-card bg-gradient-red p-4 shadow">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-uppercase opacity-75">Pending Tasks</h6>
                        <h2 class="display-6 fw-bold">@Model.Count(t => t.Status?.ToLower() == "pending")</h2>
                    </div>
                    <i class="bi bi-clock-history display-4 opacity-25"></i>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card stat-card bg-gradient-green p-4 shadow">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-uppercase opacity-75">Completed</h6>
                        <h2 class="display-6 fw-bold">@Model.Count(t => t.Status?.ToLower() == "completed")</h2>
                    </div>
                    <i class="bi bi-check2-circle display-4 opacity-25"></i>
                </div>
            </div>
        </div>
    </div>

@* --- ACTIVE TASKS TABLE (REPLACED & FIXED) --- *@
    <div class="main-card shadow-lg overflow-hidden mb-4">
        <div class="p-4 bg-white border-bottom">
            <h5 class="fw-bold mb-0 text-primary"><i class="bi bi-list-task me-2"></i>Active Assignments</h5>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 text-center">
                <thead class="table-dark">
                    <tr>
                        <th class="py-3 text-start ps-4">Task Name</th>
                        <th>Priority</th>
                        <th>Deadline</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var task in Model)
                        {
                            <tr>
                                <td class="text-start ps-4">
                                    <div class="fw-bold text-dark">@task.TaskName</div>
                                    <small class="text-muted">@task.Description</small>
                                    
                                    <div class="progress mt-2" style="height: 8px; width: 150px; border-radius: 5px;">
                                        <div class="progress-bar bg-success" role="progressbar" 
                                             style="width: @task.Progress%;" aria-valuenow="@task.Progress" 
                                             aria-valuemin="0" aria-valuemax="100"></div>
                                    </div>
                                    <small class="text-primary font-monospace" style="font-size: 0.7rem;">Progress: @task.Progress%</small>
                                </td>
                                <td>
                                    @{
                                        var pClass = task.Priority == "High" ? "bg-danger" : 
                                                    task.Priority == "Medium" ? "bg-warning text-dark" : "bg-success";
                                    }
                                    <span class="badge @pClass px-3 py-2 rounded-pill">@task.Priority</span>
                                </td>
                                <td class="text-secondary fw-semibold">
                                    @task.Deadline.ToString("MMM dd, yyyy")
                                </td>
                                <td>
                                    <span class="custom-badge @(task.Status?.ToLower() == "pending" ? "bg-light text-danger border border-danger" : "bg-light text-success border border-success")">
                                        @task.Status
                                    </span>
                                </td>
                                <td>
                                    <div class="d-flex flex-column gap-2 align-items-center">
                                        @* --- Update Progress Form --- *@
<form asp-action="UpdateProgress" asp-controller="EmployeePortal" method="post" class="d-flex align-items-center gap-2">
    <input type="hidden" name="taskId" value="@task.TaskId" />
    
    <input type="range" name="progress" class="form-range" style="width: 80px;" 
           min="0" max="100" step="10" value="@task.Progress" 
           oninput="this.nextElementSibling.innerText = this.value + '%'">
    
    <span class="badge bg-secondary" style="min-width: 40px; font-size: 0.7rem;">@task.Progress%</span>

    <button type="submit" class="btn btn-sm btn-primary rounded-circle shadow-sm" title="Save Progress">
        <i class="bi bi-check-lg"></i>
    </button>
</form>
                                        @* --- Mark Complete Form --- *@
                                        @if (task.Status?.ToLower() != "completed")
                                        {
                                            <form asp-action="MarkComplete" asp-controller="EmployeePortal" method="post" style="width: 100%;">
                                                <input type="hidden" name="taskId" value="@task.TaskId" />
                                                <button type="submit" class="btn btn-sm btn-success w-100 rounded-pill shadow-sm" style="font-size: 0.7rem;">
                                                    <i class="bi bi-check2-circle me-1"></i> Complete
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-success fw-bold small"><i class="bi bi-patch-check-fill"></i> Done</span>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="py-4 text-muted italic">No tasks assigned yet.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    @* --- LEAVE HISTORY TABLE (Wapas add kar diya) --- *@
    <div class="main-card shadow-lg overflow-hidden mb-4">
        <div class="p-4 bg-white border-bottom">
            <h5 class="fw-bold mb-0 text-warning"><i class="bi bi-calendar2-check me-2"></i>My Leave History</h5>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 text-center">
                <thead class="table-light">
                    <tr>
                        <th class="py-3">Leave Type</th>
                        <th>Duration</th>
                        <th>Reason</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (ViewBag.LeaveHistory != null)
                    {
                        foreach (var leave in (List<SmartOfficeSystem.Models.LeaveModel>)ViewBag.LeaveHistory)
                        {
                            <tr>
                                <td class="fw-bold">@leave.LeaveType</td>
                                <td>@leave.StartDate.ToShortDateString() - @leave.EndDate.ToShortDateString()</td>
                                <td><small class="text-muted">@leave.Reason</small></td>
                                <td>
                                    @{
                                        var sClass = leave.Status == "Approved" ? "bg-success" : 
                                                    leave.Status == "Rejected" ? "bg-danger" : "bg-warning text-dark";
                                    }
                                    <span class="badge @sClass px-3 py-2 rounded-pill">@leave.Status</span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    @* --- ATTENDANCE LOGS TABLE --- *@
    <div class="main-card shadow-lg overflow-hidden">
        <div class="p-4 bg-white border-bottom">
            <h5 class="fw-bold mb-0 text-info"><i class="bi bi-clock-history me-2"></i>Recent Attendance Logs</h5>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 text-center">
                <thead class="table-dark">
                    <tr>
                        <th>Date</th>
                        <th>Punch In</th>
                        <th>Punch Out</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (ViewBag.AttendanceHistory != null)
                    {
                        foreach (var log in (List<SmartOfficeSystem.Models.AttendanceModel>)ViewBag.AttendanceHistory)
                        {
                            <tr>
                                <td class="fw-bold">@(log.Date != null ? DateTime.Parse(log.Date).ToString("dd MMM yyyy") : "N/A")</td>
                                <td class="text-success fw-semibold">@log.PunchIn</td>
                                <td class="text-danger fw-semibold">@(string.IsNullOrEmpty(log.PunchOut) ? "Active..." : log.PunchOut)</td>
                                <td>
                                    <span class="badge @(string.IsNullOrEmpty(log.PunchOut) ? "bg-warning text-dark" : "bg-success") px-3 py-2 rounded-pill">
                                        @(string.IsNullOrEmpty(log.PunchOut) ? "In Office" : "Present")
                                    </span>
                                    
                                </td>
                            </tr>
                            
                        }
                    }
                    
                </tbody>
            </table>
        </div>
    </div>
</div>
