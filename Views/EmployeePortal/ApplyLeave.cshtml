@model SmartOfficeSystem.Models.LeaveModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Apply Leave";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-warning text-dark text-center py-3 rounded-top-4">
                    <h3 class="fw-bold mb-0"><i class="bi bi-calendar-plus me-2"></i>Apply For Leave</h3>
                </div>
                <div class="card-body p-4">
                    <form asp-action="ApplyLeave" method="post">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Leave Type</label>
                            <select asp-for="LeaveType" class="form-select rounded-pill">
                                <option value="Sick Leave">Sick Leave</option>
                                <option value="Casual Leave">Casual Leave</option>
                                <option value="Earned Leave">Earned Leave</option>
                            </select>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Start Date</label>
                                <input type="date" asp-for="StartDate" class="form-control rounded-pill" required />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">End Date</label>
                                <input type="date" asp-for="EndDate" class="form-control rounded-pill" required />
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold">Reason</label>
                            <textarea asp-for="Reason" class="form-control rounded-3" rows="3" placeholder="Explain your reason here..." required></textarea>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-warning btn-lg rounded-pill fw-bold shadow-sm">
                                Submit Application
                            </button>
                            <a asp-action="EmployeeDashboard" class="btn btn-light rounded-pill text-muted">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>